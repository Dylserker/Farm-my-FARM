<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import controller.GameController?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameController" alignment="CENTER" spacing="20" style="-fx-background-image: url('/Assets/Images/RangerSchool.png'); -fx-background-size: cover;">

    <Label text="Gestion de la Ferme" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <HBox alignment="CENTER" spacing="10">
        <Label fx:id="argentLabel" text="Argent: 100 pièces" />
        <Label fx:id="nourritureLabel" text="Nourriture animale: 5" />
    </HBox>

    <FlowPane alignment="CENTER" hgap="10" vgap="10">
        <Button fx:id="planterButton" text="Planter Blé" onAction="#planterCulture" />
        <Button fx:id="acheterVacheButton" text="Acheter Vache (50 pièces)" onAction="#acheterVache" />
        <Button fx:id="nourrirAnimauxButton" text="Nourrir Animaux" onAction="#nourrirAnimaux" />
        <Button fx:id="avancerJourButton" text="Avancer d'un jour" onAction="#avancerJour" />
        <Button fx:id="vendreCultureButton" text="Vendre Culture" onAction="#vendreCulture" />
        <Button fx:id="vendreVacheButton" text="Vendre Vache" onAction="#vendreVache" />
        <Button fx:id="gestionButton" text="Finances et Gestion" onAction="#afficherGestion" />
        <Button fx:id="vendreLaitButton" text="Vendre Lait" onAction="#vendreLait" />
    </FlowPane>

    <VBox alignment="CENTER" spacing="10">
        <Label text="🌱 Cultures :" />
        <GridPane fx:id="cultureList" hgap="5" vgap="5" alignment="CENTER" />

        <Label text="🐄 Animaux :" />
        <GridPane fx:id="animalList" hgap="5" vgap="5" alignment="CENTER" />

        <Label fx:id="meteoLabel" text="Météo: Ensoleillé" />

        <HBox alignment="CENTER" spacing="10">
            <Button text="Sauvegarder" onAction="#sauvegarderFerme" />
            <Button text="Charger" onAction="#chargerFerme" />
        </HBox>
    </VBox>

</VBox>