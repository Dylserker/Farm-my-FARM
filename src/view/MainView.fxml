<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import controller.GameController?>

<GridPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameController" hgap="10" vgap="10" alignment="CENTER" style="-fx-background-image: url('/Assets/Images/RangerSchool.png'); -fx-background-size: cover;">
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" />
        <ColumnConstraints halignment="CENTER" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
        <RowConstraints valignment="CENTER" />
    </rowConstraints>

    <Label text="Gestion de la Ferme" style="-fx-font-size: 20px; -fx-font-weight: bold;" GridPane.columnSpan="2" GridPane.rowIndex="0" />
    <Label fx:id="argentLabel" text="Argent: 100 pièces" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Label fx:id="nourritureLabel" text="Nourriture animale: 5" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Button fx:id="planterButton" text="Planter Blé" onAction="#planterCulture" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <Button fx:id="acheterVacheButton" text="Acheter Vache (50 pièces)" onAction="#acheterVache" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <Button fx:id="nourrirAnimauxButton" text="Nourrir Animaux" onAction="#nourrirAnimaux" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <Button fx:id="avancerJourButton" text="Avancer d'un jour" onAction="#avancerJour" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    <Button fx:id="recolterButton" text="Récolter" onAction="#recolter" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <Button fx:id="vendreCultureButton" text="Vendre Culture" onAction="#vendreCulture" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    <Button fx:id="vendreVacheButton" text="Vendre Vache" onAction="#vendreVache" GridPane.columnIndex="0" GridPane.rowIndex="5" />

    <Label text="🌱 Cultures :" GridPane.columnIndex="0" GridPane.rowIndex="6" />
    <GridPane fx:id="cultureList" hgap="5" vgap="5" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2" />

    <Label text="🐄 Animaux :" GridPane.columnIndex="0" GridPane.rowIndex="8" />
    <GridPane fx:id="animalList" hgap="5" vgap="5" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.columnSpan="2" />

    <Label fx:id="meteoLabel" text="Météo: Ensoleillé" GridPane.columnIndex="0" GridPane.rowIndex="10" GridPane.columnSpan="2" />

    <Button text="Sauvegarder" onAction="#sauvegarderFerme" GridPane.columnIndex="0" GridPane.rowIndex="11" />
    <Button text="Charger" onAction="#chargerFerme" GridPane.columnIndex="1" GridPane.rowIndex="11" />
</GridPane>